@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    .password-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: box-shadow 0.3s ease;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
    }

        .password-card:hover {
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        }

    .password-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-floating > label {
        position: absolute;
        top: 0.5rem;
        left: 0.75rem;
        padding: 0 0.25rem;
        pointer-events: none;
        color: #666;
        transition: all 0.2s ease-in-out;
        background: transparent;
        transform-origin: left top;
    }

    .form-floating > input:focus ~ label,
    .form-floating > input:not(:placeholder-shown) ~ label {
        top: -0.6rem;
        left: 0.75rem;
        font-size: 0.85rem;
        color: #4e54c8;
        background: white;
        padding: 0 0.35rem;
    }

    .form-control:focus {
        border-color: #4e54c8;
        box-shadow: 0 0 0 0.2rem rgba(78, 84, 200, 0.25);
    }

    #update-password-button {
        background: linear-gradient(to right, #4e54c8, #8f94fb);
        border: none;
        transition: background 0.3s ease;
        padding: 0.75rem;
    }

        #update-password-button:hover {
            background: linear-gradient(to right, #3e44a8, #6f74db);
        }
</style>

<div class="container px-4">
    <div class="password-title">
        <i class="bi bi-shield-lock"></i> @ViewData["Title"]
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="password-card">
                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
                        <label asp-for="Input.OldPassword" class="form-label"></label>
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="update-password-button" type="submit" class="btn btn-lg w-100 text-white">
                        <i class="bi bi-arrow-repeat me-1"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
