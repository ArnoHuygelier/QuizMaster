@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<style>
    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        max-width: 1000px;
        margin: 0 auto;
        transition: box-shadow 0.3s ease;
    }

        .auth-card:hover {
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
        }

    .auth-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-gradient {
        background: linear-gradient(to right, #4e54c8, #8f94fb);
        border: none;
        color: white !important;
        transition: background 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #3e44a8, #6f74db);
        }

    .list li {
        margin-bottom: 1.5rem;
    }

    .auth-key {
        background-color: #f8f9fa;
        padding: 0.5rem 1rem;
        font-family: monospace;
        border-radius: 0.5rem;
        display: inline-block;
    }

    #qrCode {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }
</style>

<div class="container px-4">
    <div class="auth-title">
        <i class="bi bi-phone"></i> @ViewData["Title"]
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="auth-card">
        <p>To use an authenticator app, go through the following steps:</p>
        <ol class="list">
            <li>
                <p>
                    Download a two-factor authenticator app like Microsoft Authenticator for
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank">Android</a> and
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank">iOS</a>,
                    or Google Authenticator for
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en" target="_blank">Android</a> and
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank">iOS</a>.
                </p>
            </li>
            <li>
                <p>
                    Scan the QR Code or enter this key into your authenticator app:
                    <span class="auth-key">@Model.SharedKey</span>
                    <br />
                    Spaces and casing do not matter.
                </p>
                <div class="alert alert-info">
                    Learn how to <a href="https://go.microsoft.com/fwlink/?Linkid=852423" target="_blank">enable QR code generation</a>.
                </div>
                <div id="qrCode"></div>
                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
            </li>
            <li>
                <p>
                    After scanning the QR code or entering the key, your app will provide a unique code.
                    Enter that code below to confirm setup.
                </p>
                <div class="row">
                    <div class="col-md-6">
                        <form id="send-code" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Please enter the code." />
                                <label asp-for="Input.Code" class="form-label">Verification Code</label>
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-gradient">Verify</button>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        </form>
                    </div>
                </div>
            </li>
        </ol>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
