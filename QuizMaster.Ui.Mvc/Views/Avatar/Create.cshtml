@using QuizMaster.Ui.Mvc.ViewModels.Avatars
@model CreateAvatarViewModel

@{
    ViewData["Title"] = "Create Avatar";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Create Avatar</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AvatarImage" class="form-label">Avatar Image</label>
                <input asp-for="AvatarImage" type="file" accept=".png,.jpg,.jpeg" class="form-control" />
                <span asp-validation-for="AvatarImage" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
                <button type="submit" class="btn btn-success ms-auto">
                    <i class="bi bi-check-circle"></i> Create
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
