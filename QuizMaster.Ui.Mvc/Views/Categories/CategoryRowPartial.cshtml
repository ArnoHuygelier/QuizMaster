@using System.Web
@model QuizMaster.Ui.Mvc.ViewModels.Categories.CategoryViewModel

<tr>
    <td>@Model.Name</td>
    <td>@Model.NumberOfQuizzes</td>    
    <td>
        <div class="d-flex gap-1">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
       
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteModal"
                    data-id="@Model.Id"
                    data-type="deleteButton"
                    data-name="@HttpUtility.HtmlAttributeEncode(Model.Name)">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
    </td>
</tr>
