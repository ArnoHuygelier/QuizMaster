@model Category

<tr>
    <td class="w-25">@Model.Name</td>
    <td class="w-25">@Model.Quizzes.Count</td>
    <td class="w-25">@Model.Questions.Count</td>
    <td class="w-25">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary me-1">Edit</a>

        <button type="button"
                class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-id="@Model.Id"
                data-type="deleteButton">
            Delete
        </button>
    </td>
</tr>
