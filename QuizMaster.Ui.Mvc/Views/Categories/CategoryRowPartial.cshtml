@model Category

<tr>
    <td>@Model.Name</td>
    <td>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary me-1">Edit</a>

        <button type="button"
                class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-id="@Model.Id"
                data-type="deleteButton">
            Delete
        </button>
    </td>
</tr>
