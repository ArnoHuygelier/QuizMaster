@model IEnumerable<QuizMaster.Models.Badge>

@{
    var pageSizeOptions = new[] { 5, 10, 20, 50 };
    int selectedPageSize = Context.Request.Query["pageSize"].FirstOrDefault() != null ? int.Parse(Context.Request.Query["pageSize"]) : 10;
    int page = Context.Request.Query["page"].FirstOrDefault() != null ? int.Parse(Context.Request.Query["page"]) : 1;

    var modelList = Model?.ToList() ?? new List<QuizMaster.Models.Badge>();
    var totalItems = modelList.Count;
    int totalPages = (int)Math.Ceiling((double)totalItems / selectedPageSize);
    var pagedModel = modelList.Skip((page - 1) * selectedPageSize).Take(selectedPageSize).ToList();
}


    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AddBadges</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .nav-link.active {
            border-bottom: 3px solid #0d6efd;
            font-weight: 600;
        }

        .badge-table th, .badge-table td {
            vertical-align: middle;
        }

        .table-responsive {
            max-height: 75vh;
            overflow-y: auto;
        }

        .badge-photo {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 0.5rem;
        }

        .table {
            width: 100% !important;
        }
    </style>

    <div class="container-fluid px-4 py-3">
        <nav class="nav mb-4">
            <a class="nav-link" href="#">Add Quizzes</a>
            <a class="nav-link" href="#">Add Questions</a>
            <a class="nav-link" href="#">User Management</a>
            <a class="nav-link active" href="#">Add Badges</a>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="fw-semibold">@totalItems total</span>
                <button class="btn btn-danger btn-sm ms-2">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
            <a class="btn btn-primary" href="/Badges/Create">+ Add Badges</a>
        </div>

        <div class="mb-3">
            <form method="get" class="d-flex align-items-center gap-2">
                <label for="pageSize" class="form-label mb-0">Items per page:</label>
                <select name="pageSize" id="pageSize" class="form-select w-auto" onchange="this.form.submit()">
                    @foreach (var size in pageSizeOptions)
                    {
                        if (size == selectedPageSize)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover badge-table align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th scope="col"><input type="checkbox"></th>
                        <th>#</th>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var badge in pagedModel)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>@badge.BadgeId</td>
                            <td><img src="@badge.ImageUrl" alt="@badge.Name" class="badge-photo" /></td>
                            <td>@badge.Name</td>
                            <td>@badge.Description</td>
                            <td>
                                <a href="/Badges/Edit/@badge.BadgeId" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                <a href="/Badges/Delete/@badge.BadgeId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>Showing @((page - 1) * selectedPageSize + 1)-@((page - 1) * selectedPageSize + pagedModel.Count()) of @totalItems</div>
            <div>
                <nav>
                    <ul class="pagination mb-0">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@selectedPageSize">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.js"></script>
