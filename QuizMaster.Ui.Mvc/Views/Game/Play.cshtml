@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QuizMaster.Ui.Mvc.TagHelpers
@using QuizMaster.Ui.Mvc.ViewModels.Game
@model QuizMaster.Ui.Mvc.ViewModels.Game.PlayQuestionViewModel

@{
    ViewData["Title"] = "Play Quiz";
}

<div class="container py-4">

    <div class="text-center mb-4">
        <h2 class="h4 mb-3">@Model.Title</h2>

        <div class="d-flex justify-content-center">
            <quiz-image image-url="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow" width="200" height="200" />
        </div>

        <p class="text-muted mt-2">Question @(Model.CurrentIndex + 1) of @Model.TotalQuestions</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-3">

            <h5 class="card-title mb-3">@Model.Question.QuestionText</h5>

            <form method="post" asp-action="Next" asp-controller="Game" id="quizForm">
                @Html.AntiForgeryToken()

                <!-- Hidden fields -->
                <input type="hidden" name="QuizId" value="@Model.QuizId" />
                <input type="hidden" name="QuestionId" value="@Model.Question.Id" />
                <input type="hidden" name="CorrectCount" value="@Model.CorrectCount" />
                <input type="hidden" name="CurrentIndex" value="@Model.CurrentIndex" />
                <input type="hidden" id="IsTimedOut" name="IsTimedOut" value="false" />
                <input type="hidden" name="TimeLeftInSeconds" id="TimeLeftInSeconds" />
                <input type="hidden" name="TotalTimeLeft" value="@Model.TotalTimeLeft" />
                <input type="hidden" name="AnswersSoFarJson" value='@Html.Raw(JsonSerializer.Serialize(Model.AnswersSoFar ?? new List<QuestionResultViewModel>()))' />

                <div id="answer-container">
                    @await Html.PartialAsync("QuestionPartial", Model)
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4">
                    <div id="timer" class="fw-bold text-success fs-5 mb-2 mb-md-0">⏳ 20</div>
                    <button type="submit" class="btn btn-primary w-100 w-md-auto" id="submitButton">Skip</button>
                </div>
            </form>

            @if (!Model.HintUsed)
            {
                <form method="post" asp-action="UseHint" asp-controller="Game" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="QuizId" value="@Model.QuizId" />
                    <input type="hidden" name="CorrectCount" value="@Model.CorrectCount" />
                    <input type="hidden" name="CurrentIndex" value="@Model.CurrentIndex" />
                    <input type="hidden" name="Title" value="@Model.Title" />
                    <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />
                    <input type="hidden" name="Question.Id" value="@Model.Question.Id" />
                    <input type="hidden" name="AnswersSoFarJson" value='@Html.Raw(JsonSerializer.Serialize(Model.AnswersSoFar))' />

                    <button type="submit" class="btn btn-warning w-100" @(Model.Hints == 0 ? "disabled" : "")>Get Hint (@Model.Hints left)</button>
                </form>
            }
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let seconds = 20;
        const timer = document.getElementById("timer");
        const isTimedOutInput = document.getElementById("IsTimedOut");
        const form = document.getElementById("quizForm");
        const submitButton = document.getElementById("submitButton");
        let isSubmitting = false;
        timer.textContent ="⏳ " + seconds;
        console.log("Timer script geladen");

        const countdown = setInterval(() => {
            seconds--;
            timer.textContent = `⏳ ${seconds}`;
            console.log(`Timer: ${seconds} seconden over`);

            if(seconds <= 5) {
                timer.classList.add("text-danger");
            }

            if (seconds <= 0 && !isSubmitting) {
                console.log("Timer afgelopen - formulier verzenden");
                clearInterval(countdown);
                isTimedOutInput.value = "true";
                isSubmitting = true;
                submitButton.disabled = true;
                form.submit();
            }
        }, 1000);

        form.addEventListener('submit', function(e) {
            console.log("Formulier submit event");
            if (isSubmitting) {
                console.log("Formulier al aan het verzenden - voorkomen");
                e.preventDefault();
                return;
            }

            document.getElementById("TimeLeftInSeconds").value = seconds;

            if (seconds > 0) {
                console.log("Handmatige submit - timer nog niet afgelopen");
                isTimedOutInput.value = "false";
            }

            isSubmitting = true;
            submitButton.disabled = true;
        });

        form.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });
     
        
    </script>
}