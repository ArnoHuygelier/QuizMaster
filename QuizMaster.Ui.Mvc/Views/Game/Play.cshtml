@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QuizMaster.Ui.Mvc.TagHelpers
@using QuizMaster.Ui.Mvc.ViewModels.Game
@model QuizMaster.Ui.Mvc.ViewModels.Game.PlayQuestionViewModel

@{
    ViewData["Title"] = "Play Quiz";
}

<div class="container my-5">

    

    <div class="text-center mb-4">
        <h2 class="mb-2">@Model.Title</h2>
        <quiz-image image-url="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-3" width="250" height="250" />
        <p class="text-muted">Question @(Model.CurrentIndex + 1) of @Model.TotalQuestions</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-4">@Model.Question.QuestionText</h4>

            <form method="post" asp-action="Next" asp-controller="Game" id="quizForm">
                @Html.AntiForgeryToken()

                <!-- Hidden Fields -->
                <input type="hidden" name="QuizId" value="@Model.QuizId" />
                <input type="hidden" name="QuestionId" value="@Model.Question.Id" />
                <input type="hidden" name="CorrectCount" value="@Model.CorrectCount" />
                <input type="hidden" name="CurrentIndex" value="@Model.CurrentIndex" />
                <input type="hidden" id="IsTimedOut" name="IsTimedOut" value="false" />
                <input type="hidden" name="AnswersSoFarJson" value='@Html.Raw(JsonSerializer.Serialize(Model.AnswersSoFar ?? new List<QuestionResultViewModel>()))' />

                <!-- Answer Options (no "required") -->
                <div class="d-grid gap-3 mb-4">
                    @foreach (var answer in Model.Question.Answers)
                    {
                        <button type="submit"
                                name="SelectedAnswerId"
                                value="@answer.Id"
                                class="btn btn-outline-primary btn-lg w-100 text-start">
                            @answer.AnswerText
                        </button>
                    }
                </div>
                @* <div class="list-group mb-4">
                    @foreach (var answer in Model.Question.Answers)
                    {
                        <label class="list-group-item d-flex align-items-center">
                            <input class="form-check-input me-2" type="radio" name="SelectedAnswerId" value="@answer.Id" />
                            @answer.AnswerText
                        </label>
                    }
                </div> *@

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    
                    <div id="timer" class="fw-bold text-success fs-4"></div>

                    
                    <button type="submit" class="btn btn-primary" id="submitButton">Next</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let seconds = 20;
        const timer = document.getElementById("timer");
        const isTimedOutInput = document.getElementById("IsTimedOut");
        const form = document.getElementById("quizForm");
        const submitButton = document.getElementById("submitButton");
        let isSubmitting = false;
        timer.textContent ="⏳ " + seconds;
        console.log("Timer script geladen");

        const countdown = setInterval(() => {
            seconds--;
            timer.textContent = `⏳ ${seconds}`;
            console.log(`Timer: ${seconds} seconden over`);

            if(seconds <= 5) {
                timer.classList.add("text-danger");
            }

            if (seconds <= 0 && !isSubmitting) {
                console.log("Timer afgelopen - formulier verzenden");
                clearInterval(countdown);
                isTimedOutInput.value = "true";
                isSubmitting = true;
                submitButton.disabled = true;
                form.submit();
            }
        }, 1000);

        form.addEventListener('submit', function(e) {
            console.log("Formulier submit event");
            if (isSubmitting) {
                console.log("Formulier al aan het verzenden - voorkomen");
                e.preventDefault();
                return;
            }

            if (seconds > 0) {
                console.log("Handmatige submit - timer nog niet afgelopen");
                isTimedOutInput.value = "false";
            }

            isSubmitting = true;
            submitButton.disabled = true;
        });

        form.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });

            
    </script>
}