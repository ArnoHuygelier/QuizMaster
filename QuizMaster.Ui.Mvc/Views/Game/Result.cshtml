@model QuizMaster.Ui.Mvc.ViewModels.Game.QuizResultViewModel

@{
    ViewData["Title"] = "Quiz Result";
    var isPassed = Model.CorrectCount >= Math.Ceiling(Model.Total / 2.0);
    var alertColor = isPassed ? "#28A745" : "#DC3545";
    var resultMessage = isPassed ? "Well done!" : "Better luck next time!";
    var icon = isPassed ? "bi bi-emoji-smile-fill" : "bi bi-emoji-frown-fill";
}

@section Styles {
    <link href="~/css/quiz-result.css" rel="stylesheet" />
}



<div class="container py-5">
    <h1 class="text-center">@ViewBag.Title - @Model.Title</h1>
    <div class="text-center mb-4" style="color:@alertColor;">
        <i class="@icon fs-1 mb-3"></i>
        <h2>@resultMessage</h2>
        <p class="lead">You scored: <strong>@Model.CorrectCount</strong> / <strong>@Model.Total</strong></p>
    </div>

    <div class="quiz-details">
        @foreach (var q in Model.QuestionResults)
        {
            var statusIcon = q.IsCorrect ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger";
            var yourAnswerDisplay = string.IsNullOrEmpty(q.SelectedAnswerText) ? "<em>No answer</em>" : q.SelectedAnswerText;

            <div class="result-card mb-3 p-3 shadow-sm rounded border">
                <h5 class="fw-bold">@q.QuestionText</h5>
                <p><strong>Your Answer:</strong> @Html.Raw(yourAnswerDisplay)</p>
                <p><strong>Correct Answer:</strong> @q.CorrectAnswerText</p>
                <div class="status-icon">
                    <i class="@statusIcon fs-4"></i>
                    <span class="ms-2">@((q.IsCorrect ? "Correct" : "Incorrect"))</span>
                </div>
            </div>
        }
    </div>


    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door-fill me-2"></i>Back to Home
        </a>
    </div>
</div>

@section Modals {
<div class="modal fade" id="badgesModal" tabindex="-1" aria-labelledby="badgesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title" id="badgesModalLabel">Badges Earned!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                @if (Model.BadgesEarned != null && Model.BadgesEarned.Any())
                {
                    <p class="text-center">Congratulations! You've earned the following badges:</p>
                    <div class="row g-3 justify-content-center">
                        @foreach (var badge in Model.BadgesEarned)
                        {
                            <div class="col-md-4 text-center">
                                <img src="@badge.ImageUrl" alt="@badge.Name" class="img-fluid mb-2" style="max-height: 80px;" />
                                <h6 class="text-center">@badge.Name</h6>
                                <p class="text-muted small text-center">@badge.Description</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center">No new badges earned this time. Keep playing!</p>
                }
            </div>
            <div class="modal-footer text-center d-flex justify-content-center">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Awesome!</button>
            </div>
        </div>
    </div>
</div>
}
@section Toasts
{
    <div id="toast" class="toast align-items-center text-white bg-success border-0 position-fixed top-0 start-50 translate-middle-x mt-3 p-3" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000" data-bs-autohide="true">
        <div class="toast-header">
            <strong class="me-auto">New Hint</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            You received a new hint
        </div>
    </div>
}

@section Scripts {
    <script>
        window.addEventListener('load', () => {
            const badgeCount = @Model.BadgesEarned?.Count ?? 0;
            if (badgeCount > 0) {
                const badgeModal = new bootstrap.Modal(document.getElementById('badgesModal'));
                badgeModal.show();
            }
            const newHint = @(ViewBag.NewHint != null && (bool)ViewBag.NewHint ? "true" : "false");
            if (newHint === true) {
                const toastDiv = document.getElementById('toast');
                const toast = new bootstrap.Toast(toastDiv);
                toast.show();
            }
        });
    </script>
}
