@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.QuizDetailsViewModel
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = Model.Title;
    var isSignedIn = SignInManager.IsSignedIn(User);
    var noQuestions = TempData["NoQuestions"] is bool b && b;
}

<!-- External Styles -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .neon-button {
        transition: all 0.3s ease-in-out;
        box-shadow: 0 0 10px #0d6efd;
    }

        .neon-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 20px #0d6efd, 0 0 40px #0d6efd;
        }

    .card-highlight {
        border-left: 5px solid #0d6efd;
    }

    .stats-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #6c757d;
    }

    .leaderboard-icon {
        font-size: 1.25rem;
        color: gold;
    }
</style>

<div class="container py-5 animate__animated animate__fadeIn">

    <!-- Header -->
    <section class="row align-items-center mb-5">
        <div class="col-md-3 text-center mb-4 mb-md-0">
            <quiz-image image-url="@Model.ImageUrl" class="img-fluid rounded shadow-lg" alt="@Model.Title" />
        </div>
        <div class="col-md-9">
            <h1 class="fw-bold display-4">@Model.Title</h1>
            <p class="text-muted fs-5">@Model.Description</p>
            <div class="d-flex flex-wrap gap-4 text-secondary mt-3">
                <div><i class="bi bi-tag-fill me-1"></i><strong>@Model.Category</strong></div>
                <div><i class="bi bi-calendar-event me-1"></i>@Model.Created</div>
                <div><i class="bi bi-person-circle me-1"></i>By <strong>@Model.UserName</strong></div>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="bg-white rounded shadow-sm p-4 mb-5 text-center border">
        <div class="row g-4 justify-content-center">
            <div class="col-6 col-md-3">
                <div class="stats-title">Total Questions</div>
                <div class="fs-4 fw-bold">@Model.NumberOfQuestions</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-title">Your Score</div>
                @if (Model.UserScore == 0)
                {
                    <div class="text-muted">You haven't played this quiz</div>
                }
                else
                {
                    <div class="fs-4 fw-bold">@Model.UserScore / @Model.NumberOfQuestions</div>
                }
            </div>
        </div>

        <div class="mt-4">
            @if (!isSignedIn)
            {
                <button class="btn btn-lg btn-secondary px-5" disabled>
                    <i class="bi bi-lock-fill me-2"></i>Please sign in to play
                </button>
            }
            else if (Model.NumberOfQuestions == 0)
            {
                <button class="btn btn-lg btn-secondary px-5" disabled>
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>No questions available
                </button>
            }
            else
            {
                <a asp-controller="Game" asp-action="Start" asp-route-id="@Model.Id" class="btn btn-lg btn-primary px-5 neon-button">
                    <i class="bi bi-play-circle-fill me-2"></i>Play Quiz
                </a>
            }
        </div>
    </section>
    
    @if (Model.TopScorers.Any())
    {
        <!-- Leaderboard -->
        <article class="card shadow-sm mb-5 card-highlight">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-trophy-fill leaderboard-icon me-2"></i>Top Scorers</h5>
                
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var score in Model.TopScorers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-star-fill text-warning me-2"></i><strong>@score.UserName</strong></span>
                            <span class="badge bg-primary rounded-pill">@score.Score</span>
                        </li>
                    }
                    
                </ul>
            </div>
        </article>
    }
    

   @*  <!-- Quiz Modes -->
    <article class="card shadow-sm mb-5">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">Quiz Modes</h5>
            <div>
                <a href="#" class="text-muted me-3 text-decoration-none"><i class="bi bi-flag"></i> Report</a>
                <i class="bi bi-three-dots-vertical text-muted"></i>
            </div>
        </div>
        <div class="card-body">
            <ul class="list-unstyled">
                <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Multiple Choice:</strong> Choose from options.</li>
                <li><i class="bi bi-arrow-down-up text-primary me-2"></i><strong>Forced Order:</strong> Must answer in sequence.</li>
                <li><i class="bi bi-exclamation-circle-fill text-danger me-2"></i><strong>Minefield:</strong> One wrong answer ends the quiz.</li>
                <li><i class="bi bi-shuffle text-warning me-2"></i><strong>Random Order:</strong> Questions are shuffled.</li>
            </ul>
        </div>
    </article> *@
</div>

<!-- Modal for No Questions -->
@if (noQuestions)
{
    <script>
        window.onload = () => {
            document.body.insertAdjacentHTML('beforeend', `
                <div class="modal fade" id="noQuestionsModal" tabindex="-1" aria-labelledby="noQuestionsModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="noQuestionsModalLabel">No Questions Found</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                This quiz contains no questions. Please add questions before starting the quiz.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>`);
            new bootstrap.Modal(document.getElementById('noQuestionsModal')).show();
        };
    </script>
}

