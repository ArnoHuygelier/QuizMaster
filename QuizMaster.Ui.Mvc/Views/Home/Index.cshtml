@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <!-- Header Carousel -->
    <div id="heroCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="images/slider.png" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="images/slider.png" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>

    <!-- Filter Tags -->
    <div class="mb-4">
        <button class="btn btn-outline-secondary btn-sm me-2">All Recommendations</button>
        <button class="btn btn-outline-secondary btn-sm me-2">History</button>
        <button class="btn btn-outline-secondary btn-sm me-2">Vue JS</button>
        <button class="btn btn-outline-secondary btn-sm me-2">Music</button>
        <button class="btn btn-outline-secondary btn-sm me-2">Search</button>
    </div>

    <!-- Popular Quiz Topics -->
    <h4>Popular Quiz Topics</h4>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col">
                <div class="card quiz-card h-100">
                    <img src="images/homeImageBlokken.png" class="card-img-top" alt="Quiz">
                    <div class="card-body">
                        <h6 class="card-title">Vue JS Quiz</h6>
                        <p class="card-text small text-muted">Master the fundamentals of Vue JS through interactive questions.</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Trending Course -->
    <h4>Trending Course</h4>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
        @for (int i = 0; i < 4; i++)
        {
            <div class="col">
                <div class="card quiz-card h-100">
                    <img src="images/homeImageBlokken.png" class="card-img-top" alt="Course">
                    <div class="card-body">
                        <h6 class="card-title">History Quiz</h6>
                        <p class="card-text small text-muted">Challenge your knowledge of global history.</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Popular Players -->
    <h4>Popular Players</h4>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5">
        <div class="col text-center player-card">
            <img src="images/person.png" alt="" class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;" />
            <div class="fw-bold">Alexander Bastian</div>
            <div class="text-muted small">Quiz Challenger</div>
        </div>
        <div class="col text-center player-card">
            <img src="images/person.png" alt="" class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;" />
            <div class="fw-bold">Labie Carthaline</div>
            <div class="text-muted small">Morning Sprinter</div>
        </div>
        <div class="col text-center player-card">
            <img src="images/person.png" alt="" class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;" />
            <div class="fw-bold">Jonathan Doe</div>
            <div class="text-muted small">Focused & Steady</div>
        </div>
        <div class="col text-center player-card">
            <img src="images/person.png" alt="" class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;" />
            <div class="fw-bold">Kitani Saraswati</div>
            <div class="text-muted small">Top Global Player</div>
        </div>
    </div>
</div>
