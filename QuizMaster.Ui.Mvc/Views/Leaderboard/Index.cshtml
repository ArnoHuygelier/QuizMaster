                }

                <li class="list-group-item bg-primary text-white fw-bold">
                    <div class="row text-center">
                        <div class="col-1">Rank</div>
                        <div class="col-4 text-start">Name</div>
                        <div class="col-2">Score</div>
                        <div class="col-3">Badge</div>
                        <div class="col-2">Joined</div>
                    </div>
                </li>

                @foreach (var team in teams)
                {
                    <li class="list-group-item bg-white rounded shadow-sm mb-2">
                        <div class="row align-items-center text-center">
                            <div class="col-1">
                                <span class="badge bg-primary">#@team.Rank</span>
                            </div>
                            <div class="col-4 d-flex align-items-center">
                                <img src="@team.Avatar" class="rounded-circle" alt="Avatar" width="30" height="30"/>
                                <div class="ms-2 fw-semibold text-dark">@team.Name</div>
                            </div>
                            <div class="col-2 text-warning fw-bold">
                                <i class="bi bi-star-fill"></i> @team.Score.ToString("0.00")
                            </div>
                            <div class="col-3">
                                @if (team.Badge == "Gold")
                                {
                                    <span class="badge bg-warning text-dark">Gold</span>
                                }
                                else if (team.Badge == "Silver")
                                {
                                    <span class="badge bg-secondary">Silver</span>
                                }
                                else if (team.Badge == "Bronze")
                                {
                                    <span class="badge bg-bronze">Bronze</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">No Badge</span>
                                }
                            </div>
                            <div class="col-2 fw-semibold text-dark">
                                @team.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>