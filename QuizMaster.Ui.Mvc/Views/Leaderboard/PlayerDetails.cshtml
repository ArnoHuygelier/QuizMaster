@using QuizMaster.Ui.Mvc.ViewModels.Leaderboard
@model List<PlayerDetailsViewModel>

@{
    ViewBag.Title = "PlayerDetails";
}

<h2 class="my-4 text-primary">Leaderboard</h2>

<div class="container bg-light-subtle p-4 rounded" style="min-height: 60vh">
    <div class="row">
        <div class="col-12">
            <ul class="list-group list-group-flush">
                @if(Model.Count == 0)
                {
                    <span class="text-muted small">This player hasn't played any quizzes yet</span>
                }
                else
                {
                    <li class="list-group-item bg-primary text-white fw-bold">
                        <div class="row text-center">
                            <div class="col-3">Quiz</div>
                            <div class="col-3">Score</div>
                            <div class="col-3">Answers</div>
                            <div class="col-3">Played at</div>
                        </div>
                    </li>
                    @foreach (var item in Model)
                    {
                        <partial name="PlayerDetailsRowPartial" model="item"></partial>
                    }
                }
            </ul>
        </div>
    </div>
</div>