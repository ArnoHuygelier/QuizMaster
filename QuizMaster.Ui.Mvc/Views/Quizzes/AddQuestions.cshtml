@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.AddQuestionsViewModel

@section Styles {
    <link href="~/css/custom-page.css" rel="stylesheet" />
    
}

<div class="container py-5">
    <h2 class="mb-4 text-center">Step 2: Add Quiz Questions to @Model.QuizTitle</h2>

    <form asp-action="AddQuestions" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="QuizId"/>

        <div id="question-container" data-question-count="@Model.Questions.Count">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = Model.Questions[i];
                <div class="card mb-4 pt-3 pb-3" data-index="@i">
                    <div class="d-flex justify-content-between align-items-center mb-2 pe-3">
                        <h5>Question @(i + 1)</h5>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeQuestion(this)">Remove</button>
                    </div>

                    <div class="form-group pe-3">
                        <label>Question Text</label>
                        <input type="text" name="Questions[@i].Text" value="@question.Text" class="form-control" placeholder="Enter your question"/>
                        <span class="text-danger" data-valmsg-for="Questions[@i].Text" data-valmsg-replace="true"></span>
                    </div>

                    <label class="mt-3 fw-bold d-block pe-3">Select the correct answer</label>

                    @for (int j = 0; j < question.Answers.Count; j++)
                    {
                        var answer = question.Answers[j];
                        var isCorrect = j == question.CorrectAnswerIndex;
                        <div class="form-check mb-2 pe-3 @(isCorrect ? "correct-selected" : "")">
                            <input class="form-check-input" type="radio" name="Questions[@i].Correct" value="@j" @(isCorrect ? "checked" : "") onchange="markCorrect(this)">
                            <input type="text" class="form-control" name="Questions[@i].Answers[@j].AnswerText" value="@answer.AnswerText" placeholder="Answer @(j + 1)"/>
                            <span class="text-danger" data-valmsg-for="Questions[@i].Answers[@j].AnswerText" data-valmsg-replace="true"></span>
                        </div>
                    }
                </div>
            }
        </div>

        <button type="button" class="btn my-3" id="add-question-btn">➕ Add Question</button>
        <br/>
        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Create" class="btn btn-secondary">Back</a>
    </form>
</div>
    <style>
        
    </style>


   

@section Scripts
{
    <script src="~/js/addQuestion.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial"/>
}
