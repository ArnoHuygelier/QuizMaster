@model AddQuestionsViewModel

<div class="container py-5">
    <h2 class="mb-4 text-center">Step 2: Add Quiz Questions to @Model.QuizTitle</h2>

    <form asp-action="AddQuestions" method="post">
        <input type="hidden" asp-for="QuizId" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div id="question-container"></div>

        <button type="button" class="btn my-3" id="add-question-btn">➕ Add Question</button>
        <br />
        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Create" class="btn btn-secondary">Back</a>
    </form>

    <style>
        .form-check.correct-selected {
            background-color: transparent;
            border: none;
            padding: 0;
        }

            .form-check.correct-selected input[type="text"] {
                background-color: white;
            }

        .form-check {
            display: flex;
            align-items: center;
            padding: 0.5rem 0;
        }

        .form-check-input {
            margin-right: 15px;
            margin-left: 4px;
            accent-color: #007bff;
            width: 1.2em;
            height: 1.2em;
            flex-shrink: 0;
        }

        .form-check input[type="text"] {
            flex: 1;
        }

        #add-question-btn {
            background: linear-gradient(to right, #00c6ff, #0072ff);
            color: white;
            font-weight: bold;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            transition: background 0.3s ease;
        }

            #add-question-btn:hover {
                background: linear-gradient(to right, #0094d9, #0051cc);
            }

        .card {
            padding-left: 1.5rem;
        }
    </style>

    <script>
        let questionIndex = 0;

        document.getElementById("add-question-btn").addEventListener("click", () => {
            addQuestion();
        });

        window.onload = () => {
            addQuestion();
        };

        function addQuestion() {
            const container = document.getElementById('question-container');
            const card = document.createElement('div');
            card.className = 'card mb-4 pt-3 pb-3';
            card.setAttribute('data-index', questionIndex);

            const namePrefix = `Questions[${questionIndex}]`;

            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2 pe-3">
                    <h5>Question ${questionIndex + 1}</h5>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeQuestion(this)">Remove</button>
                </div>

                <div class="form-group pe-3">
                    <label>Question Text</label>
                    <input type="text" name="${namePrefix}.Text" class="form-control" placeholder="Enter your question">
                    <span class="text-danger" data-valmsg-for="${namePrefix}.Text" data-valmsg-replace="true"></span>
                </div>

                <label class="mt-3 fw-bold d-block pe-3">Select the correct answer</label>

                ${[0, 1, 2, 3].map(i => `
                    <div class="form-check mb-2 pe-3">
                        <input class="form-check-input" type="radio" name="${namePrefix}.Correct" value="${i}" onchange="markCorrect(this)">
                        <input type="text" class="form-control" name="${namePrefix}.Answers[${i}].AnswerText" placeholder="Answer ${i + 1}">
                        <span class="text-danger" data-valmsg-for="${namePrefix}.Answers[${i}].AnswerText" data-valmsg-replace="true"></span>
                    </div>
                `).join('')}
            `;

            container.appendChild(card);
            questionIndex++;
        }

        function removeQuestion(button) {
            const card = button.closest('.card');
            card.remove();
            renumberQuestions();
        }

        function renumberQuestions() {
            const container = document.getElementById('question-container');
            const cards = container.querySelectorAll('.card');
            questionIndex = 0;

            cards.forEach(card => {
                card.setAttribute('data-index', questionIndex);
                card.querySelector('h5').textContent = `Question ${questionIndex + 1}`;

                const namePrefix = `Questions[${questionIndex}]`;

                card.querySelector(`input[name$=".Text"]`).name = `${namePrefix}.Text`;

                const radios = card.querySelectorAll(`input[type="radio"]`);
                radios.forEach((radio, i) => {
                    radio.name = `${namePrefix}.Correct`;
                    radio.value = i;
                });

                const texts = card.querySelectorAll(`input[type="text"]`);
                let textCounter = 0;
                texts.forEach((text, i) => {
                    if (!text.name.endsWith(".Text")) {
                        text.name = `${namePrefix}.Answers[${textCounter}].AnswerText`;
                        textCounter++;
                    }
                });

                questionIndex++;
            });
        }

        function markCorrect(radio) {
            const groupName = radio.name;
            const allOptions = document.querySelectorAll(`input[name="${groupName}"]`);
            allOptions.forEach(r => {
                const wrapper = r.closest('.form-check');
                wrapper.classList.remove('correct-selected');
            });
            radio.closest('.form-check').classList.add('correct-selected');
        }
    </script>
</div>
