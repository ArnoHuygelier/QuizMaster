@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.AddQuestionsViewModel

@section Styles {
    <link href="~/css/add-questions.css" rel="stylesheet" />
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Step 2: Add Quiz Questions to @Model.QuizTitle</h5>
    </div>
    <div class="card-body">
        <form asp-action="AddQuestions" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="QuizId" />

            <div id="question-container" data-question-count="@Model.Questions.Count">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var question = Model.Questions[i];
                    <div class="card mb-4 pt-3 pb-3" data-index="@i">
                        <div class="d-flex justify-content-between align-items-center mb-2 pe-3 px-3">
                            <h5 class="mb-0">Question @(i + 1)</h5>
                            <button type="button" class="btn btn-danger btn-sm" onclick="removeQuestion(this)">
                                <i class="bi bi-trash"></i> Remove
                            </button>
                        </div>

                        <div class="form-group px-3 pe-3">
                            <label class="form-label">Question Text</label>
                            <input type="text" name="Questions[@i].Text" value="@question.Text" class="form-control" placeholder="Enter your question" />
                            <span class="text-danger" data-valmsg-for="Questions[@i].Text" data-valmsg-replace="true"></span>
                        </div>

                        <label class="mt-3 fw-bold d-block px-3">Select the correct answer</label>

                        @for (int j = 0; j < question.Answers.Count; j++)
                        {
                            var answer = question.Answers[j];
                            var isCorrect = j == question.CorrectAnswerIndex;
                            <div class="form-check mb-2 px-3 @(isCorrect ? "correct-selected" : "")">
                                <input class="form-check-input" type="radio" name="Questions[@i].CorrectAnswerIndex" value="@j" @(isCorrect ? "checked" : "") onchange="markCorrect(this)" />
                                <input type="text" class="form-control" name="Questions[@i].Answers[@j].AnswerText" value="@answer.AnswerText" placeholder="Answer @(j + 1)" />
                                <span class="text-danger" data-valmsg-for="Questions[@i].Answers[@j].AnswerText" data-valmsg-replace="true"></span>
                            </div>
                        }
                    </div>
                }
            </div>

            <button type="button" class="btn btn-primary mb-3" id="add-question-btn">
                <i class="bi bi-plus-circle"></i> Add Question
            </button>

            <div class="d-flex justify-content-between gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.QuizId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back
                </a>
                <button type="submit" class="btn btn-success ms-auto">
                    <i class="bi bi-check-circle"></i> Save Questions
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/Questions.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial"/>
}
