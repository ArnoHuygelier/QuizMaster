
﻿@using QuizMaster.Ui.Mvc.ViewModels.Quizzes
@model CreateQuizViewModel

@{
    ViewBag.Title = "Create Quiz";
}

<div class="container py-5">
    <h2 class="mb-4 text-center">@ViewBag.Title</h2>
    <div class="form-container" style="max-width: 600px; margin: auto;">
        <form asp-action="Create" method="post">
            <partial name="CreateEditPartial" model="Model" />
            <div class="d-flex justify-content-between">
                <a href="/" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Next</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}