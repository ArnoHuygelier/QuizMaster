@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.EditQuizViewModel

@{
    ViewData["Title"] = "Edit Quiz";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Edit Quiz</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.UserId)

            @* Partial met de form velden *@
            <partial name="CreateEditPartial" model="Model" />

            <div class="d-flex align-items-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>

                <div class="ms-auto d-flex gap-2">
                    <a asp-action="EditQuestions" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square"></i> Edit Questions
                    </a>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
