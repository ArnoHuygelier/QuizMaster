@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.QuizzesViewModel

@{
    ViewData["Title"] = "Quizzes";
}

<h1>@ViewBag.Title</h1>

<a asp-action="Create" class="btn btn-primary mb-3">New Quiz</a>

<table class="table">
    <thead class="thead-dark">
        <tr>
            <th class="w-30">Title</th>
            <th class="w-25">Amount of questions</th>
            <th class="w-25">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quiz in Model.Quizzes)
        {
            <partial name="QuizRowPartial" model="quiz" />
        }
    </tbody>
</table>

@section Modals
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="deleteModalLabel">Delete Quiz</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this quiz "<span id="quizName"></span>"?</p>
                </div>
                <div class="modal-footer">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="Id" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                        <button type="submit" class="btn btn-danger">Yes, delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <script>
        $(function ()
        {
            $("[data-type='deleteButton']").on("click", function ()
            {
                let id = $(this).data("id");
                let input = $("input[name='Id']", "#deleteModal");
                $(input).val(id);

                let name = $(this).data("name");
                $("#quizName").html(name);
            });
        });
    </script>
}
