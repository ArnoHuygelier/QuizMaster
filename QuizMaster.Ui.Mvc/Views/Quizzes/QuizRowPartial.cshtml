@using System.Web
@model QuizMaster.Ui.Mvc.ViewModels.Quizzes.QuizViewModel

<tr>
    <td class="w-25">@Model.Title</td>
    <td class="w-25">@Model.Description</td>

    <td class="w-25">@Model.NumberOfQuestions</td>
    <td class="w-25">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary me-1">Edit</a>

        <button type="button"
                class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-id="@Model.Id"
                data-type="deleteButton"
                data-name="@HttpUtility.HtmlAttributeEncode(Model.Title)">
            Delete
        </button>
    </td>
</tr>
