<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizMaster.Ui.Mvc</title>

    <!-- Bootstrap 5 + Icons via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuizMaster.Ui.Mvc.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- HEADER -->
    <header class="border-bottom box-shadow mb-3">
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" style="height: 40px;" />
                    <strong>QuizMaster</strong>
                </a>

                <!-- Hamburger toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible content -->
                <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Browse
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">All Quizzes</a></li>
                                <li><a class="dropdown-item" href="#">Categories</a></li>
                            </ul>
                        </li>
                    </ul>

                    <form class="d-flex mb-3 mb-lg-0 me-lg-3" role="search">
                        <input class="form-control me-2" type="search" placeholder="Search for quiz" aria-label="Search">
                        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                    </form>

                    <!-- Login/Logout Section -->
                    <div class="d-flex align-items-center gap-3">
                        @await Html.PartialAsync("_LoginPartial")  <!-- Login Partial -->
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN -->
    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer bg-dark text-light pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-12 col-md-3 mb-4">
                    <img src="~/images/logo.png" alt="Logo" style="height: 40px;" class="mx-auto d-block d-md-inline" />
                    <h5 class="mt-2 fw-bold">QuizMaster</h5>
                </div>
                <div class="col-6 col-md-3 mb-4">
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none d-block" href="#">Popular Quizzes</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">Leaderboard</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">My Account</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 mb-4">
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none d-block" href="#">FAQ</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">Feedback</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">Report a Problem</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3 mb-4">
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none d-block" href="#">Contact us</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">Privacy</a></li>
                        <li><a class="text-light text-decoration-none d-block" href="#">About Us</a></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start">
                <p class="mb-2 mb-md-0 small">&copy; <strong>QuizMaster.io</strong> 2024. All Rights Reserved</p>
                <div class="social-icons">
                    <a href="#" class="text-light me-3"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-light me-3"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-light"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- JS (Bootstrap Bundle incl. Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
