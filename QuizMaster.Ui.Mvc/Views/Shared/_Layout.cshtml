@using System.Collections.Specialized
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - QuizMaster.Ui.Mvc</title>

    <!-- Bootstrap CSS + Icons via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuizMaster.Ui.Mvc.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- HEADER -->
    <header class="border-bottom shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" aria-label="QuizMaster Home">
                <img src="~/images/logo.png" alt="QuizMaster Logo" style="height: 40px;" />
                <strong class="text-dark m-0">QuizMaster</strong>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Homepage</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN -->
    <main role="main" class="container flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer bg-dark text-light pt-4 pb-3 mt-auto">
        <div class="container text-center">
            <div class="mb-3">
                <a href="/Home/Contact" class="text-light text-decoration-none me-4">Contact Us</a>
                <a href="/Home/Privacy" class="text-light text-decoration-none me-4">Privacy Policy</a>
                <a href="/Home/Tos" class="text-light text-decoration-none me-4">Terms of Service</a>
                <a href="/Home/About" class="text-light text-decoration-none">About Us</a>
            </div>

            <hr class="border-secondary" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-2 mb-md-0 small">&copy; <strong>QuizMaster.io</strong> 2025. All Rights Reserved</p>
                <div class="social-icons">
                    <a href="#" class="text-light me-3"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-light me-3"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-light"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Modals", required: false)
    <!-- JQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap Bundle JS (incl. Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Your site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
