@model IEnumerable<UserBadge>
@{
    ViewData["Title"] = "My Badges";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .badge-card {
            transition: transform 0.2s ease-in-out;
        }

            .badge-card:hover {
                transform: translateY(-5px);
            }

        .badge-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #ffc107;
        }

        .badge-title {
            font-size: 1.2rem;
            margin-top: 1rem;
        }

        .badge-description {
            color: #6c757d;
        }
    </style>
}

<div class="admin-layout d-flex">
    <div class="admin-content flex-grow-1 p-4">
        <h1 class="mb-4">My Badges</h1>

        @if (!Model.Any())
        {
            <div class="alert alert-info">You haven't earned any badges yet.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var userBadge in Model)
                {
                    <div class="col">
                        <div class="card badge-card h-100 shadow-sm text-center">
                            <div class="card-body">
                                <img src="@userBadge.Badge.ImageUrl" alt="@userBadge.Badge.Name"
                                     class="badge-image mb-3" />
                                <h5 class="badge-title">@userBadge.Badge.Name</h5>
                                <p class="badge-description">@userBadge.Badge.Description</p>
                            </div>
                            <div class="card-footer text-muted">
                                Awarded: @userBadge.AwardedAt.ToString("dd MMM yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
