@model CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
    var roles = ViewBag.Roles as List<string>;
}

<div class="d-flex flex-column flex-shrink-0 bg-dark text-white" style="position: fixed; top: 0; left: 0; width: 280px; height: 100vh;">
    <partial name="SidebarPartial" />
</div>

<div class="container mt-5 vh-100">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Create User</h2>
            <form asp-action="Create" method="post">
                
                <partial name="CreateEditUserFormPartial" model="@Model"></partial>

                <div class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-success">Create User</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
