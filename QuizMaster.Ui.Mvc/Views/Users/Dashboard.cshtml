@model IdentityUser

<!-- Flex container voor de layout, zet de breedte op 100% -->
<div class="container d-flex" style="width: 100%; min-height: 100vh;">
    <!-- Sidebar, volledig tegen de linker rand, zonder marges of padding -->
    <div class="d-flex flex-column flex-shrink-0 bg-dark text-white" style="position: fixed; top: 0; left: 0; width: 280px; height: 100vh;">
        <partial name="SidebarPartial" />
    </div>

    <!-- Hoofdinhoud, start na de sidebar (verschoven naar rechts door de sidebar) -->
    <div class="flex-grow-1" style="margin-left: 280px; padding-top: 20px;">
        <div class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
            <h1>Welcome @Model.UserName</h1>
        </div>
    </div>
</div>
