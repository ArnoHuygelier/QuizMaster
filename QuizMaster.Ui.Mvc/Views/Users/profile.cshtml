@model User

@{
    ViewData["Title"] = "My Account";
}

<div class="container mt-5">
    <h2 class="text-center">My Account</h2>
    <ul class="nav nav-pills justify-content-center mt-4">
        <li class="nav-item">
            <a class="nav-link active" href="#">Profile</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">Personalisation</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">Account</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">Badges</a>
        </li>
    </ul>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="text-center">
                <!-- Assuming AvatarId or Avatar can provide an image URL -->
                <img src="https://www.example.com/path-to-your-image.jpg" alt="Profile Image" class="img-fluid rounded-circle" width="150" height="150">
                <button class="btn btn-secondary mt-2">Change</button>
            </div>
        </div>
        <div class="col-md-8">
            <form asp-action="SaveProfile"> <!-- Assuming a SaveProfile action in your controller -->
                <div class="mb-3">
                    <label for="Username" class="form-label">Username</label>
                    <input type="text" class="form-control" id="Username" value="@Model.UserName" disabled />
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label">Email</label>
                    <input type="text" class="form-control" id="Email" value="@Model.Email" disabled />
                </div>
                <div class="mb-3">
                    <label for="IsActive" class="form-label">Account Active</label>
                    <input type="checkbox" class="form-check-input" id="IsActive" value="true" @if (Model.IsActive) { <text>checked</text> } />
                </div>
                <div class="mb-3">
                    <label for="NewsLetter" class="form-label">Newsletter Subscription</label>
                    <input type="checkbox" class="form-check-input" id="NewsLetter" value="true" @if (Model.NewsLetter) { <text>checked</text> } />
                </div>
                <div class="mb-3">
                    <label for="Score" class="form-label">Score</label>
                    <input type="text" class="form-control" id="Score" value="@Model.Score" disabled />
                </div>
                <div class="mb-3">
                    <label for="AvatarId" class="form-label">Avatar</label>
                    <select class="form-select" id="AvatarId">
                        <!-- Loop through available Avatars (assuming this data is passed from your controller) -->
@*                         @foreach (var avatar in Model.AvatarList) 
                        {
                            <option value="@avatar.Id" @if (Model.AvatarId == avatar.Id) { <text>selected</text> }>@avatar.Name</option>
                        } *@
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>
